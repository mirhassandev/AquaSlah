<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Golden Crescent Moon (Islamic Spiritual Motif) -->
    <path android:pathData="M 60,26 C 75,28 84,40 84,54 C 84,68 75,80 60,82 C 72,78 78,67 78,54 C 78,41 72,30 60,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="26"
                android:endX="84"
                android:endY="82"
                android:type="linear">
                <item android:color="#FFE082" android:offset="0.0" />
                <item android:color="#FFB300" android:offset="0.6" />
                <item android:color="#FF8F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Pure Water Droplet (Hydration Core) -->
    <path android:pathData="M 46,26 C 46,26 28,50 28,60 C 28,70 36,78 46,78 C 56,78 64,70 64,60 C 64,50 46,26 46,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="26"
                android:endX="46"
                android:endY="78"
                android:type="linear">
                <item android:color="#80D8FF" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="0.4" />
                <item android:color="#0091EA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Glossy Highlight Curve on Droplet -->
    <path
        android:pathData="M 42,34 C 36,44 34,54 38,64 C 35,62 33,52 38,40 C 40,36 42,34 42,34 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.65" />

    <!-- Ripple Base Accent Ring -->
    <path
        android:pathData="M 32,72 C 38,76 54,76 60,72 C 54,74 38,74 32,72 Z"
        android:fillColor="#80DEEA"
        android:fillAlpha="0.5" />

    <!-- 4-Point Golden Celestial Star -->
    <path
        android:pathData="M 72,30 Q 72,34 76,34 Q 72,34 72,38 Q 72,34 68,34 Q 72,34 72,30 Z"
        android:fillColor="#FFF59D" />

</vector>
